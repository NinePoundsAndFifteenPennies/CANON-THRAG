# TH-RAG configuration defaults
# Field behavior, inactive settings, and concurrency: ../docs/config_reference.md
# Server setup and credential entry: SETUP_GUIDE.md

# Storage
THRAG_STORAGE_ROOT=/data/panzheng/canon-thrag

# vLLM service
LLM_API_KEY=your_vllm_api_key_here
LLM_BASE_URL=http://222.27.255.211:11434/v1
LLM_THINKING=disabled

# Model IDs; the current service also accepts Qwen/Qwen3.5-9B.
DEFAULT_MODEL=Qwen3.5-9B
CHAT_MODEL=Qwen3.5-9B
EVAL_MODEL=Qwen3.5-9B

# Local embedding
E5_MODEL_PATH=/data/panzheng/bearrag/models/e5-base-v2
E5_BATCH_SIZE=32
E5_MAX_LENGTH=512

# Generation: actual scope and overrides are documented in the reference.
TEMPERATURE=0.5
MAX_TOKENS_RESPONSE=16384
ANSWER_TEMPERATURE=0.3
ANSWER_MAX_TOKENS=1000
EVAL_TEMPERATURE=0.1

# Tokenization and chunking
CHAT_TOKENIZER_PATH=tokenizers/qwen3.5-9b
MAX_TOKENS=3000
OVERLAP=300
ALT_MAX_TOKENS=1200
ALT_OVERLAP=100
MAX_WORKERS=4

# Topic/subtopic selection
TOPIC_CHOICE_MIN=5
TOPIC_CHOICE_MAX=10
SUBTOPIC_CHOICE_MIN=10
SUBTOPIC_CHOICE_MAX=25
MAX_RETRIES=10
RETRY_BACKOFF=0.2

# Retrieval
TOP_K1=50
TOP_K2=10
TOP_K1_LONG=25
TOP_K2_LONG=5
EMBEDDING_TOP_K=5
OVERRETRIEVE_FACTOR=5
MAX_CONTEXT_LENGTH=49152

# Legacy system fields: see the reference before changing these values.
LOG_LEVEL=INFO
LOG_FILE=thrag.log
BATCH_SIZE=32
TIMEOUT_SECONDS=30
ENABLE_CACHE=true
CACHE_TTL=3600

# Optional CANON pipeline; the original pipeline does not read these switches.
# CLI overrides are documented in SETUP_GUIDE.md; semantics in config_reference.md.
CANON_HIERARCHY=split_merge
CANON_SOFT_LINKS=true
CANON_ROUTING=hybrid
CANON_BRIDGE=true
CANON_BALANCE=true

# Offline canonicalization and lateral links
CANON_MERGE_NEIGHBORS=20
CANON_MERGE_LABEL_THRESHOLD=0.90
CANON_MERGE_CONTEXT_THRESHOLD=0.90
CANON_SENTENCE_PROTOTYPE_WEIGHT=0.80
CANON_SOFT_LABEL_THRESHOLD=0.85
CANON_SOFT_CONTEXT_THRESHOLD=0.85
CANON_SOFT_NEIGHBORS=5
CANON_SOFT_TRANSITION_WEIGHT=0.25

# A: dual-seed diffusion
CANON_SEED_SENTENCES=32
CANON_SEED_LABELS=32
CANON_BOTTOM_UP_WEIGHT=0.50
CANON_RESTART=0.15
CANON_DIFFUSION_ITERATIONS=100
CANON_DIFFUSION_TOLERANCE=0.000001

# B and hybrid: candidate scoring and evidence cards
CANON_ACTIVATION_LABEL_WEIGHT=0.50
CANON_ACTIVATION_TOP_N=3
# Zero derives a candidate cap of twice the corresponding selection maximum.
CANON_CANDIDATE_TOPICS=0
CANON_CANDIDATE_SUBTOPICS=0
CANON_PREVIEW_INPUT_TOKENS=8192
CANON_PREVIEW_SENTENCE_TOKENS=32
CANON_PREVIEW_ENTITIES=2
CANON_ROUTE_ATTEMPTS=3

# Evidence allocation
CANON_BRIDGE_SEED_SENTENCES=5
CANON_BRIDGE_WEIGHT=0.20
CANON_COVERAGE_WEIGHT=0.30
