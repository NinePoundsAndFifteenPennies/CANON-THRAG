# TH-RAG 默认配置
# 参数含义、未启用的配置项和并发说明：../docs/config_reference.md
# 服务器安装与密钥填写：SETUP_GUIDE.md

# 数据与结果的存储根目录
THRAG_STORAGE_ROOT=/data/panzheng/canon-thrag

# vLLM 模型服务
LLM_API_KEY=your_vllm_api_key_here
LLM_BASE_URL=http://222.27.255.211:11434/v1
LLM_THINKING=disabled

# 模型名称；当前服务也接受 Qwen/Qwen3.5-9B。
DEFAULT_MODEL=Qwen3.5-9B
CHAT_MODEL=Qwen3.5-9B
EVAL_MODEL=Qwen3.5-9B

# 本地向量模型
E5_MODEL_PATH=/data/panzheng/bearrag/models/e5-base-v2
E5_BATCH_SIZE=32
E5_MAX_LENGTH=512

# 文本生成；各参数的实际作用范围和覆盖规则见配置说明。
TEMPERATURE=0.5
MAX_TOKENS_RESPONSE=16384
ANSWER_TEMPERATURE=0.3
ANSWER_MAX_TOKENS=1000
EVAL_TEMPERATURE=0.1

# 分词、文本切块与并发
CHAT_TOKENIZER_PATH=tokenizers/qwen3.5-9b
MAX_TOKENS=3000
OVERLAP=300
ALT_MAX_TOKENS=1200
ALT_OVERLAP=100
MAX_WORKERS=4

# 主题与子主题选择，以及请求重试
TOPIC_CHOICE_MIN=5
TOPIC_CHOICE_MAX=10
SUBTOPIC_CHOICE_MIN=10
SUBTOPIC_CHOICE_MAX=25
MAX_RETRIES=10
RETRY_BACKOFF=0.2

# 检索数量与模型上下文长度
TOP_K1=50
TOP_K2=10
TOP_K1_LONG=25
TOP_K2_LONG=5
EMBEDDING_TOP_K=5
OVERRETRIEVE_FACTOR=5
MAX_CONTEXT_LENGTH=49152

# 原系统保留字段；哪些字段实际生效见配置说明。
LOG_LEVEL=INFO
LOG_FILE=thrag.log
BATCH_SIZE=32
TIMEOUT_SECONDS=30
ENABLE_CACHE=true
CACHE_TTL=3600

# CANON 增强入口的可选配置；原 pipeline 不读取这些开关。
# 单条命令用法见 canon/USAGE.md；第二版改动见 ../docs/canon_v2_changes.md。
# normalize：审核同义关系后合并，不按父主题把所有共享子主题拆开。
# split 只拆分；split_merge 使用旧版的拆分和相似度合并算法；none 不做归一化。
CANON_HIERARCHY=normalize
CANON_SOFT_LINKS=true
CANON_ROUTING=hybrid
CANON_BRIDGE=true
CANON_BALANCE=true

# 离线归一化与同层软连接
CANON_MERGE_NEIGHBORS=20
CANON_MERGE_LABEL_THRESHOLD=0.90
CANON_MERGE_CONTEXT_THRESHOLD=0.90
CANON_SENTENCE_PROTOTYPE_WEIGHT=0.80
# normalize 的离线同义审核：每批候选对数、总候选对上限、每个节点的原句数与每句字符上限。
# MAX_PAIRS 为 0 表示不限制总候选对数；预算在主题和子主题候选之间交替分配。
CANON_SYNONYM_BATCH_SIZE=8
CANON_SYNONYM_MAX_PAIRS=2000
CANON_SYNONYM_CONTEXTS=3
CANON_SYNONYM_EVIDENCE_CHARS=240
CANON_SOFT_LABEL_THRESHOLD=0.85
CANON_SOFT_CONTEXT_THRESHOLD=0.85
CANON_SOFT_NEIGHBORS=5
CANON_SOFT_TRANSITION_WEIGHT=0.25

# 路由 A：从句子和标签两类种子出发，进行带重启的迭代扩散
CANON_SEED_SENTENCES=32
CANON_SEED_LABELS=32
CANON_BOTTOM_UP_WEIGHT=0.50
CANON_RESTART=0.15
CANON_DIFFUSION_ITERATIONS=100
CANON_DIFFUSION_TOLERANCE=0.000001

# 路由 B 与 hybrid 融合版：候选评分与证据预览
CANON_ACTIVATION_LABEL_WEIGHT=0.50
CANON_ACTIVATION_TOP_N=3
# 为 0 时，候选主题数、每个主题的候选子主题数分别取对应选择上限的两倍。
CANON_CANDIDATE_TOPICS=0
CANON_CANDIDATE_SUBTOPICS=0
# 整次路由请求的输入 token 上限，包含问题、候选名称、实体和原句；超出时减少候选。
CANON_PREVIEW_INPUT_TOKENS=10240
# 每个候选的原句预览最多保留多少 token。
CANON_PREVIEW_SENTENCE_TOKENS=32
CANON_PREVIEW_ENTITIES=2
CANON_ROUTE_ATTEMPTS=3

# 证据分配：桥梁加权与分支覆盖
CANON_BRIDGE_SEED_SENTENCES=5
CANON_BRIDGE_WEIGHT=0.20
CANON_COVERAGE_WEIGHT=0.30
# 先按未加桥梁分的相关性保护这部分 K2 原文块名额，再用剩余名额补充分支覆盖。
CANON_COVERAGE_ANCHOR_FRACTION=0.50
